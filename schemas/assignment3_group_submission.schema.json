{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assignment 3 Group Chain of Contracts Submission",
  "type": "object",
  "required": ["assignment", "title", "network", "group", "chain", "report"],
  "properties": {
    "assignment": {"const": "assignment3"},
    "title": {"const": "Group Chain of Contracts"},
    "network": {"const": "sepolia"},
    "group": {
      "type": "object",
      "required": ["group_id", "members"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["student_id", "name", "wallet", "role", "owned_contract", "deployment_tx"],
            "properties": {
              "student_id": {"type": "string"},
              "name": {"type": "string"},
              "wallet": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
              "role": {"type": "string"},
              "owned_contract": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
              "deployment_tx": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"}
            }
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "required": ["chain_entry", "chain_links", "chain_terminal", "start_chain_tx", "explorer_url", "input_data", "expected_event_order", "final_result"],
      "properties": {
        "chain_entry": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
        "chain_links": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"}},
        "chain_terminal": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
        "connection_txs": {"type": "array", "items": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"}},
        "start_chain_tx": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"},
        "explorer_url": {"type": "string"},
        "input_data": {"type": "string"},
        "expected_event_order": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "final_result": {"type": "string"}
      }
    },
    "report": {
      "type": "object",
      "required": ["repository_url", "report_path"],
      "properties": {
        "repository_url": {"type": "string"},
        "report_path": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
