{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blockchain Course Submission",
  "type": "object",
  "required": [
    "student",
    "wallets"
  ],
  "properties": {
    "student": {
      "type": "object",
      "required": [
        "full_name",
        "student_id",
        "github_username"
      ]
    },
    "wallets": {
      "type": "object"
    },
    "labs": {
      "type": "object"
    },
    "assignments": {
      "type": "object"
    }
  }
}